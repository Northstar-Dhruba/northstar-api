# Copy to .env beside compose.yaml and fill in. Never commit .env.

# Site served by Caddy; a public DNS name gets automatic HTTPS.
NORTHSTAR_SITE_ADDRESS=
# The browser origin of that site, e.g. https://<NORTHSTAR_SITE_ADDRESS>. Never *.
NORTHSTAR_WEB_ORIGIN=

# Deployment-boundary login. Hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
# Keep the hash in single quotes; bcrypt hashes contain '$'.
NORTHSTAR_BASIC_AUTH_USER=
NORTHSTAR_BASIC_AUTH_HASH=''

# SQLite on the persistent local volume mounted at /data.
NORTHSTAR_DATABASE=/data/northstar.sqlite3

# The one operated contract, strategy label, paper portfolio and fixed target.
NORTHSTAR_FUTURES_PRODUCT=
NORTHSTAR_FUTURES_EXCHANGE=
NORTHSTAR_FUTURES_EXPIRATION=
NORTHSTAR_STRATEGY=
NORTHSTAR_PORTFOLIO=
NORTHSTAR_TARGET=

# Secret. Passed only to the operations service.
DATABENTO_API_KEY=
