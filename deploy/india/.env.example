# Northstar Indian Futures paper environment. Copy to .env beside this
# directory's compose.yaml, in the Indian checkout, and fill in. Never commit
# .env. Placeholders only: no real token, account ID or password belongs here.
#
# Not configurable, by design. Frozen in code: the K = 5 pre-expiry flatten,
# the strategy rule and its warm-up window, next-open paper fills and the NSE
# session calendar. Fixed in compose.yaml: the Upstox market-data provider.
# There is no automatic rollover and no time-of-day finality.

# --- Secrets -----------------------------------------------------------------

# Upstox analytics token. Passed only to india-operations, never to the API.
# Needed for market-data sync and for the operated finality modes; disabled
# finality neither reads nor needs it.
UPSTOX_ANALYTICS_TOKEN=

# Login for the Indian dashboard (Caddy basic auth). Hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
# Keep the hash in single quotes; bcrypt hashes contain '$'.
NORTHSTAR_BASIC_AUTH_USER=
NORTHSTAR_BASIC_AUTH_HASH=''

# --- Deployment configuration ------------------------------------------------

# Host loopback port of the Indian dashboard (reach it through an SSH tunnel),
# and that site's browser origin.
NORTHSTAR_INDIA_WEB_PORT=8081
NORTHSTAR_WEB_ORIGIN=http://localhost:8081

# SQLite on the Indian volume (northstar-india-data) mounted at /data.
NORTHSTAR_DATABASE=/data/northstar.sqlite3

# The one operated dated contract, strategy label, monthly paper portfolio and
# fixed target. A new contract month gets a new portfolio identity.
NORTHSTAR_FUTURES_PRODUCT=NIFTY
NORTHSTAR_FUTURES_EXCHANGE=NSE
NORTHSTAR_FUTURES_EXPIRATION=2026-10-27
NORTHSTAR_STRATEGY=directional-mvp-v1-nifty-paper-ops
NORTHSTAR_PORTFOLIO=nifty-paper-ops-oct26
NORTHSTAR_TARGET=1

# Daily-bar finality: disabled (fails closed: nothing is acquired or decided),
# operator-approved (acquires and decides no new NSE session; it only waits)
# or operator-reviewed, which acquires and decides sessions through
# FINAL_THROUGH only when each candle is the exact version approved below.
# FINAL_THROUGH is a trading date the operator has verified, YYYY-MM-DD; it is
# never derived from the clock. Once a database has run in an operated mode it
# is reviewed-candle protected, and disabled or an unset mode is refused.
NORTHSTAR_FUTURES_DAILY_BAR_FINALITY=disabled
NORTHSTAR_FUTURES_FINAL_THROUGH=

# Approved candle versions, operator-reviewed only: comma-separated
# <expiration>/<trading date>=fdc1-sha256:<64 lowercase hex>, no spaces.
# Produce each entry with 'northstar finality-evidence identity' after the N-4
# review, and add it only under a recorded FG-8 authorization. Empty approves
# nothing. Fingerprints are Upstox-derived (G-1): never commit a real one.
NORTHSTAR_FUTURES_APPROVED_CANDLES=

# First NSE trading session the portfolio decides on, YYYY-MM-DD. Used only
# while no decision has been frozen; leave empty until bootstrap is verified.
NORTHSTAR_FUTURES_GO_LIVE=
