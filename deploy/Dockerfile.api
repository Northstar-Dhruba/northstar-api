# syntax=docker/dockerfile:1
# Northstar Python image: `northstar-api` (default) and `northstar operations daily`.
#
# Build context is the Northstar workspace root, because uv.lock resolves the
# path dependencies as siblings (../northstar-core and so on):
#
#   docker build -f northstar-api/deploy/Dockerfile.api -t northstar-api:local .

FROM ghcr.io/astral-sh/uv:0.12.17 AS uv

FROM python:3.13-slim AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY northstar-core/ northstar-core/
COPY northstar-application/ northstar-application/
COPY northstar-infrastructure/ northstar-infrastructure/
COPY northstar-api/ northstar-api/
WORKDIR /app/northstar-api
# Non-editable: the virtualenv carries every sibling package and needs no sources.
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.13-slim
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin northstar \
    && mkdir /data \
    && chown northstar:northstar /data
COPY --from=build /app/northstar-api/.venv /app/northstar-api/.venv
ENV PATH=/app/northstar-api/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1
USER northstar
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8000
CMD ["northstar-api"]
