# syntax=docker/dockerfile:1
# Northstar web image: the static dashboard built with Node 22, served by Caddy,
# which also reverse-proxies the API and holds the authentication boundary.
#
# Build context is the Northstar workspace root:
#
#   docker build -f northstar-api/deploy/Dockerfile.web -t northstar-web:local .

FROM node:22.23.2-alpine AS build
WORKDIR /web
COPY northstar-web/package.json northstar-web/package-lock.json ./
RUN npm ci
COPY northstar-web/ ./
# Same origin: Caddy forwards /api/* to northstar-api with the prefix stripped.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM caddy:2-alpine
COPY northstar-api/deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
